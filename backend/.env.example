# Backend environment configuration
# Copy to .env and adjust values for your environment
# Hexa settings are prefixed with HEXA_ (see app/config.py)

HEXA_APP_NAME=Hexta
HEXA_ENVIRONMENT=development
HEXA_API_PREFIX=/api/v1
HEXA_LOG_LEVEL=INFO

# Database — connects to the shared Postgres instance
# The database `hexa_assistant` and role `hexa_app` are created by
# infra/shared/postgres/init/01_hexa_assistant.sql on first container start.
# Set the password via scripts/migrate_db.sh (do NOT commit it).
HEXA_DATABASE_URL=postgresql://hexa_app:devpass@127.0.0.1:5432/hexa_assistant
HEXA_DATABASE_POOL_MAX=4
HEXA_DATABASE_POOL_TIMEOUT_S=30

# Auth — generate a strong key for production (see docs/)
HEXA_JWT_SECRET=dev-only-secret-change-me-in-production-32chars
HEXA_JWT_ALGORITHM=HS256
HEXA_JWT_EXPIRY_MINUTES=480

# CORS — comma-separated origins; "*" only in non-production
HEXA_CORS_ORIGINS=*

# Embeddings (FastEmbed nomic-embed-text-v1.5, 768-dim, ~137MB)
HEXA_EMBEDDING_ENABLED=true
HEXA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
HEXA_EMBEDDING_CACHE_DIR=nlp_models/embeddings

# Storage paths (relative to backend/)
HEXA_STORAGE_PENDING_DIR=storage/pending
HEXA_STORAGE_PROCESSED_DIR=storage/processed
HEXA_MAX_UPLOAD_BYTES=20971520

# Search limits
HEXA_BM25_LIMIT=25
HEXA_MAX_SUB_QUERIES=6
# Longest phrase (in words) checked against the alias/abbreviation table
# when resolving a query (see query_processing/alias_resolver.py).
HEXA_MAX_ALIAS_NGRAM=3

# Response limits
HEXA_MAX_EXCERPT_CHARS=600
HEXA_MAX_EVIDENCE_DOCS=3

# Behavioural
HEXA_AUTO_CREATE_SCHEMA=true
HEXA_AUDIT_ENABLED=true

# Cross-encoder reranker — reorders the top RRF candidates using the
# ONNX/FastEmbed stack already in the image. Enabled by default; set to
# false to fall back to plain RRF order. rerank_top_k is budget-derived
# (<200ms p95, CLAUDE.md rule 6) -- see config.py before changing it.
HEXA_RERANK_ENABLED=true
HEXA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
HEXA_RERANK_CACHE_DIR=nlp_models/reranker
HEXA_RERANK_TOP_K=5
